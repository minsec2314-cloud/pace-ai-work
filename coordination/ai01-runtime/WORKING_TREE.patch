+for(const matching of [false,true])test(`ask integrates explicit work association:${matching}`,async()=>{let calls=0;const source={id:'synthetic-material',subjectId:'s',kind:'lesson',name:matching?'작품가.pdf':'작품나.pdf',sections:[{page:1,text:'검증할 예제 구절입니다. 이 자료는 모의 검사에서만 사용하는 창작 문장입니다.'}]};const result=await generateAI({mode:'ask',subject:'국어',question:'「작품가」 원문을 설명해줘',materials:[source]},'synthetic-only',async()=>{calls++;return Response.json({choices:[{finish_reason:'stop',message:{content:JSON.stringify({text:'원문은 “검증할 예제 구절입니다”입니다.',referenceIds:['R1']})}}]});});assert.equal(calls,1);assert.equal(result.text.includes('원문은'),matching);if(!matching)assert.equal(result.citations.length,0);});
