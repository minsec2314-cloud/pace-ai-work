+// Metadata relevance is a conservative screen, not verification of paper claims.
+export function researchMatches(query:string,source:Source):boolean {
+ const q=query.normalize('NFKC').toLowerCase();
+ const text=(source.title+' '+source.abstract).normalize('NFKC').toLowerCase();
+ const compact=(s:string)=>s.replace(/[\s-]+/g,'');
+ const groups:[RegExp,RegExp][]=[
+  [/전지|battery|batteries/,/전지|\bbatter(?:y|ies)\b/],
+  [/나트륨\s*이온|sodium[ -]?ion/,/나트륨\s*이온|\bsodium[ -]?ion\b/],
+  [/리튬\s*황|lithium[ -]?sulfur/,/리튬\s*황|\blithium[ -]?sulfur\b/],
+  [/전고체|solid[ -]?state/,/전고체|\bsolid[ -]?state\b/],
+ ];
+ const required=groups.filter(([pattern])=>pattern.test(q));
+ if(!required.every(([,pattern])=>pattern.test(text)))return false;
+ // A recognized domain term must not erase additional user constraints.
+ // These query patterns contain no capturing groups or stateful flags.
+ let remainder=q;
+ for(const [pattern] of required)remainder=remainder.replace(new RegExp(pattern.source,'g'),' ');
+ if(required.length)remainder=remainder.replace(/차세대|화학|\bnext[ -]?generation\b/g,' ');
+ const terms=(remainder.match(/[\p{L}\p{N}]{2,}/gu)||[]).filter(term=>!['the','and','for','of','in','on','with'].includes(term));
+ return (required.length>0||terms.length>0)&&terms.every(term=>compact(text).includes(compact(term)));
+}
