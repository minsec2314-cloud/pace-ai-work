+for(const correct of [true,false])test(`legacy citation excerpt itself must contain quoted words:${correct}`,async()=>{const line='검증할 예제 구절입니다';const rest='작품가의 장르에 관한 설명입니다';const material={id:'legacy-source',subjectId:'s',kind:'lesson',name:'작품가.pdf',sections:[{page:1,text:line+'\n'+rest}]};const result=await generateAI({mode:'ask',subject:'국어',question:'「작품가」 원문을 설명해줘',materials:[material]},'synthetic-only',async()=>Response.json({choices:[{finish_reason:'stop',message:{content:JSON.stringify({text:`원문은 “${line}”입니다.`,citations:[{materialId:material.id,page:1,quote:correct?line:rest}]})}}]}));assert.equal(result.text.includes('원문은'),correct);});
